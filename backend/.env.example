# ==============================================================================
# CLIQ Backend — Environment Variables Template
# Copy to backend/.env and populate with your credentials.
# NEVER commit real credentials to version control.
# ==============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO
APP_SECRET_KEY=change_this_to_a_secure_random_secret_at_least_32_chars

# Database Configuration
# Local SQLite fallback for offline development / isolated unit testing:
# DATABASE_URL=sqlite+aiosqlite:///./data/cliq.db
#
# Production Supabase PostgreSQL (Supports both Direct and Transaction Pooler URLs):
# The backend automatically maps postgresql:// to postgresql+asyncpg:// with SSL enabled.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example (Supabase Pooler):
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase Auth and Storage (Optional for local standalone mode, required for Supabase cloud)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# AI Provider Configuration
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL_NAME=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_PER_MINUTE=600
MAX_UPLOAD_SIZE_BYTES=10485760 # 10MB

